<Window x:Class="LocalMark.View.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="500" MinWidth="480"
        Background="#FAFBFC">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E0E3E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输出目录 -->
        <GroupBox Grid.Row="0" Header="标注结果输出">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Content="存放位置" />
                <TextBox Grid.Column="1" Text="{Binding OutputDir}"
                         Margin="0,0,8,0" IsReadOnly="False" />
                <Button Grid.Column="2" Content="浏览..."
                        Command="{Binding BrowseOutputDirCommand}"
                        Padding="12,6" MinWidth="56" />
            </Grid>
        </GroupBox>

        <!-- 图片 AI -->
        <GroupBox Grid.Row="1" Header="图片 AI — 本地 Ollama（免费）">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="服务地址" />
                    <TextBox Grid.Column="1" Text="{Binding OllamaHost}"
                             Margin="0,0,0,8" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="模型名称" />
                    <TextBox Grid.Column="1" Text="{Binding OllamaModel}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- 文本 AI -->
        <GroupBox Grid.Row="2" Header="文本 AI — 云端 API">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="接口地址" />
                    <TextBox Grid.Column="1" Text="{Binding TextAiEndpoint}"
                             Margin="0,0,0,8" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="密钥" />
                    <TextBox Grid.Column="1" Text="{Binding TextAiApiKey}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="模型名称" />
                    <TextBox Grid.Column="1" Text="{Binding TextAiModel}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- 提示 -->
        <TextBlock Grid.Row="3" Margin="2,6,0,0"
                   FontSize="12" Foreground="#8899AA"
                   TextWrapping="Wrap" LineHeight="18">
            <Run Text="图片 AI 基于本地 Ollama 运行，无需联网或付费；" />
            <Run Text="文本 AI 需填写第三方 API 接口地址与密钥，支持 DeepSeek、OpenAI 等兼容服务。" />
            <LineBreak />
            <Run Text="标注结果将自动保存至上方设置的输出目录。" />
        </TextBlock>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Command="{Binding CloseWindowCommand}"
                    Background="#F0F1F3" Foreground="#555"
                    Margin="0,0,10,0" />
            <Button Content="保存设置" Command="{Binding SaveCommand}"
                    Background="#2563EB" Foreground="White"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
