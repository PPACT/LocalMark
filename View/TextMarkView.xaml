<Window x:Class="LocalMark.View.TextMarkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本标注" Height="460" Width="660"
        MinHeight="380" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FAFBFC">
    <Window.Resources>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Name="bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,10"
                BorderBrush="#E8ECF2" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="选择标签" VerticalAlignment="Center"
                       FontSize="13" Foreground="#555" />
                <ComboBox ItemsSource="{Binding Labels}"
                          SelectedItem="{Binding SelectedLabel}"
                          DisplayMemberPath="Name"
                          MinWidth="160" FontSize="13"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="6"
                BorderBrush="#E0E3E8" BorderThickness="1" Padding="12">
            <TextBox Text="{Binding SourceContent}"
                     TextWrapping="Wrap" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14" BorderThickness="0"
                     Background="Transparent" Foreground="#334155" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Command="{Binding SaveCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#2563EB" Foreground="White"
                    BorderBrush="Transparent" FontWeight="SemiBold"
                    Margin="0,0,10,0" />
            <Button Content="取消" Command="{Binding CloseWindowCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#F1F5F9" Foreground="#555"
                    BorderBrush="#D0D5DD" />
        </StackPanel>
    </Grid>
</Window>
