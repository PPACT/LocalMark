<Window x:Class="LocalMark.View.TextMarkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalMark.ViewModel"
        Title="文本标注" Height="450" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标签选择 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="选择标注标签：" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Labels}"
                      SelectedItem="{Binding SelectedLabel}"
                      DisplayMemberPath="Name"
                      MinWidth="150" />
        </StackPanel>

        <!-- 文本内容 -->
        <TextBox Grid.Row="1" Text="{Binding SourceContent}"
                 TextWrapping="Wrap" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="14" Margin="0,0,0,10" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="保存" Command="{Binding SaveCommand}"
                    Width="80" Margin="0,0,10,0" FontWeight="Bold" />
            <Button Content="取消" Command="{Binding CloseWindowCommand}"
                    Width="80" />
        </StackPanel>
    </Grid>
</Window>
