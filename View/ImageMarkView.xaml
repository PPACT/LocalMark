<Window x:Class="LocalMark.View.ImageMarkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvt="clr-namespace:LocalMark.Converters"
        Title="图片标注" Height="640" Width="940"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FAFBFC">
    <Window.Resources>
        <cvt:PathToImageConverter x:Key="PathToImageConverter" />
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Name="bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,10"
                BorderBrush="#E8ECF2" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="标注标签" VerticalAlignment="Center" FontSize="13" Foreground="#555" />
                <ComboBox ItemsSource="{Binding Labels}" SelectedItem="{Binding SelectedLabel}"
                          DisplayMemberPath="Name" MinWidth="160" FontSize="13"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="（拖拽鼠标绘制标注框）" Foreground="#94A3B8" FontSize="12"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E3E8" BorderThickness="1"
                CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Image x:Name="ImgDisplay"
                       Source="{Binding ImagePath, Converter={StaticResource PathToImageConverter}}"
                       Stretch="Uniform" />
                <Canvas x:Name="MarkCanvas"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                        Background="Transparent">
                    <Rectangle x:Name="MarkRect" Stroke="#EF4444" StrokeThickness="2.5"
                               Fill="Transparent" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="清除标注" Click="ClearBox_Click"
                    Style="{StaticResource BtnBase}"
                    Background="#F1F5F9" Foreground="#555" BorderBrush="#D0D5DD" />
            <Button Content="保存" Command="{Binding SaveCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#2563EB" Foreground="White" BorderBrush="Transparent"
                    FontWeight="SemiBold" Margin="10,0,0,0" />
            <Button Content="取消" Command="{Binding CloseWindowCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#F1F5F9" Foreground="#555" BorderBrush="#D0D5DD"
                    Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
