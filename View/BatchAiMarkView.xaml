<Window x:Class="LocalMark.View.BatchAiMarkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvt="clr-namespace:LocalMark.Converters"
        Title="批量 AI 标注" Height="540" Width="760"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FAFBFC">
    <Window.Resources>
        <cvt:BoolInvertConverter x:Key="BoolInvert" />
        <Style x:Key="StatusStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="成功">
                    <Setter Property="Foreground" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Foreground" Value="#DC2626" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="跳过">
                    <Setter Property="Foreground" Value="#94A3B8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="处理中...">
                    <Setter Property="Foreground" Value="#EA580C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="无检出">
                    <Setter Property="Foreground" Value="#F59E0B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Name="bd">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 进度区 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8"
                Padding="16,14" Margin="0,0,0,12"
                BorderBrush="#E8ECF2" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <ProgressBar Height="10"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding DisplayProgressValue}"
                                 BorderThickness="0"
                                 Background="#E5E7EB"
                                 Foreground="#2563EB"
                                 Margin="0,0,0,8" />
                    <TextBlock HorizontalAlignment="Right"
                               Margin="10,0,0,0"
                               Text="{Binding DisplayProgressValue, StringFormat={}{0:F0}%}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#2563EB"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,4,0,0"
                           FontSize="13" Foreground="#666"
                           Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <!-- 当前项 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,10"
                BorderBrush="#E8ECF2" BorderThickness="1">
            <TextBlock FontSize="13" Foreground="#444"
                       Text="{Binding CurrentItem}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 结果列表 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#E0E3E8" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      Background="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F1F3"
                      RowHeight="34"
                      FontSize="12.5"
                      ColumnHeaderHeight="34"
                      EnableRowVirtualization="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FB" />
                        <Setter Property="Foreground" Value="#666" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="#E0E3E8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}"
                                        Width="36" />
                    <DataGridTextColumn Header="类型" Binding="{Binding DataType}"
                                        Width="52" />
                    <DataGridTextColumn Header="内容摘要" Binding="{Binding Content}"
                                        Width="*" MaxWidth="280">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="处理结果" Binding="{Binding Summary}" Width="*"
                                        MinWidth="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource StatusStyle}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="开始处理" Command="{Binding StartCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#2563EB" Foreground="White" BorderBrush="Transparent"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvert}}"
                    Margin="0,0,8,0" />
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#F1F5F9" Foreground="#555" BorderBrush="#D0D5DD"
                    IsEnabled="{Binding IsRunning}"
                    Margin="0,0,8,0" />
            <Button Content="关闭" Command="{Binding CloseWindowCommand}"
                    Style="{StaticResource BtnBase}"
                    Background="#F1F5F9" Foreground="#555" BorderBrush="#D0D5DD"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvert}}" />
        </StackPanel>
    </Grid>
</Window>
