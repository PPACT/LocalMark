<Window x:Class="LocalMark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvt="clr-namespace:LocalMark.Converters"
        Title="LocalMark v2.1" Height="720" Width="1200"
        MinHeight="550" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB">
    <Window.Resources>
        <cvt:DataTypeConverter x:Key="DataTypeConverter" />
        <cvt:MarkedStatusConverter x:Key="MarkedStatusConverter" />
        <cvt:IndexPlusOneConverter x:Key="IndexConverter" />
        <cvt:ThumbnailConverter x:Key="ThumbnailConverter" />
        <cvt:BoolInvertConverter x:Key="BoolInvert" />
        <cvt:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Name="bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AiBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
            <Setter Property="Foreground" Value="#166534"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Foreground" Value="#DC2626"/>
        </Style>

        <Style x:Key="SettingsBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="36"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E3E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F1F3"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style x:Key="DataGridColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E0E3E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="DataGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="#2563EB" BorderThickness="0,0,0,0"
                                Name="bd" Cursor="Hand">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              TextBlock.Foreground="#666"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,3"/>
                                <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E3E8"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LocalMark" FontSize="18" FontWeight="Bold"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                    <TextBlock Text="v2.1" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="⚙"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource SettingsBtn}" ToolTip="系统设置"/>
            </Grid>
        </Border>

        <!-- 三 Tab -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#F8F9FB" BorderThickness="0">

            <!-- ========== Tab 1: 素材标注 ========== -->
            <TabItem Header="素材标注">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E0E3E8"
                            BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📄 导入文本" Command="{Binding ImportTextFileCommand}" Style="{StaticResource ToolBtn}"/>
                            <Button Content="🖼 导入图片" Command="{Binding ImportImageFilesCommand}" Style="{StaticResource ToolBtn}" Margin="6,0,0,0"/>
                            <Button Content="📁 导入文件夹" Command="{Binding ImportFolderCommand}" Style="{StaticResource ToolBtn}" Margin="6,0,0,0"/>
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8"/>
                            <Button Content="✏️ 手动标注" Command="{Binding OpenMarkViewCommand}" Style="{StaticResource AccentBtn}"/>
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8"/>
                            <Button Content="🤖 批量 AI 标注" Command="{Binding BatchAiMarkCommand}" Style="{StaticResource AiBtn}"/>
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8"/>
                            <Button x:Name="ClearBtn" Content="🗑 清除 ▾" Style="{StaticResource ToolBtn}" Click="ClearBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除已标注（隐藏）" Command="{Binding ClearMarkedCommand}"/>
                                        <MenuItem Header="清除未标注（删除）" Command="{Binding ClearUnmarkedCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="清除所有" Command="{Binding ClearAllCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 筛选 -->
                    <Border Grid.Row="1" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="仅显示未标注" IsChecked="{Binding ShowUnmarkedOnly}" Foreground="#555" VerticalAlignment="Center"/>
                            <Separator Width="1" Margin="16,2" Background="#E0E3E8"/>
                            <CheckBox Content="全选" IsChecked="{Binding IsAllSelected}" Foreground="#555" VerticalAlignment="Center"/>
                            <Separator Width="1" Margin="16,2" Background="#E0E3E8"/>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="13" Padding="4,3"
                                     BorderBrush="#D0D5DD" Background="#FAFBFC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                              AutoGenerateColumns="False" SelectionMode="Single" RowHeaderWidth="0"
                              CanUserAddRows="False" AlternationCount="100000"
                              Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColHeader}"
                              CellStyle="{StaticResource DataGridCell}" Margin="12,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F6F8FC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Background" Value="#FFFDE7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style x:Key="ChkBoxStyle" TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChkBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Width="48" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Converter="{StaticResource IndexConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="文件名" Binding="{Binding SourceName}" Width="120" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="预览" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Content, Converter={StaticResource ThumbnailConverter}}"
                                               Width="36" Height="28" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Width="60" Binding="{Binding DataType, Converter={StaticResource DataTypeConverter}}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="素材内容" Binding="{Binding Content}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" Width="70" IsReadOnly="True"
                                                Binding="{Binding IsMarked, Converter={StaticResource MarkedStatusConverter}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== Tab 2: 标注结果 ========== -->
            <TabItem Header="标注结果">
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 导出工具栏 -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,12"
                            BorderBrush="#E8ECF2" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="导出标注数据" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="格式:" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="20,0,6,0"/>
                            <ComboBox Grid.Column="2" Width="130" FontSize="13"
                                      ItemsSource="{Binding ExportFormats}"
                                      SelectedItem="{Binding SelectedExportFormat}"/>
                            <Button Grid.Column="4" Content="📦 导出" Command="{Binding ExportToJsonCommand}"
                                    Style="{StaticResource ExportBtn}" Width="100" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="已完成标注" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button Content="删除全部" Command="{Binding DeleteAllResultsCommand}"
                                Style="{StaticResource DangerBtn}" Margin="20,0,0,0" Width="90"/>
                        <Button Content="刷新" Command="{Binding RefreshSourcesCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0" Width="70"/>
                    </StackPanel>

                    <!-- 结果列表 -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource DataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridColHeader}"
                              CellStyle="{StaticResource DataGridCell}" AlternationCount="100000">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F6F8FC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="48" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Converter="{StaticResource IndexConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="文件名" Width="140" Binding="{Binding FileName}"/>
                            <DataGridTextColumn Header="类型" Width="60" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="标签" Width="80" Binding="{Binding Label}"/>
                            <DataGridTextColumn Header="标注时间" Width="140" Binding="{Binding MarkedAt}"/>
                            <DataGridTextColumn Header="内容摘要" Width="*" Binding="{Binding Content}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== Tab 3: 格式转换 ========== -->
            <TabItem Header="格式转换">
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据集格式互转" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,0,0,14"/>

                    <!-- 转换面板 -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,14"
                            BorderBrush="#E8ECF2" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 源 -->
                            <StackPanel>
                                <TextBlock Text="源数据集" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ConvertSourcePath}" IsReadOnly="True"
                                             FontSize="12" Padding="6,4" Background="#FAFBFC" BorderBrush="#D0D5DD"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseConvertSourceCommand}"
                                            Style="{StaticResource ToolBtn}" MinWidth="60" Padding="8,4" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding ConvertSourceFormat, StringFormat=检测格式: {0}}"
                                           FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="→" FontSize="24" FontWeight="Bold"
                                       Foreground="#2563EB" VerticalAlignment="Center" Margin="30,10,30,0"/>

                            <!-- 目标 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标格式" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding ConvertTargetFormat}"
                                          FontSize="13" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ConvertOutputDir}" IsReadOnly="True"
                                             FontSize="12" Padding="6,4" Background="#FAFBFC" BorderBrush="#D0D5DD"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseConvertOutputCommand}"
                                            Style="{StaticResource ToolBtn}" MinWidth="60" Padding="8,4" Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 转换按钮 -->
                    <Button Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Content="🔄 开始格式转换" Command="{Binding ConvertFormatCommand}"
                            Style="{StaticResource AccentBtn}" MinWidth="180" FontSize="14" Padding="16,10"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
