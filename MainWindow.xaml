<Window x:Class="LocalMark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvt="clr-namespace:LocalMark.Converters"
        Title="LocalMark v1.1" Height="680" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB">
    <Window.Resources>
        <cvt:DataTypeConverter x:Key="DataTypeConverter" />
        <cvt:MarkedStatusConverter x:Key="MarkedStatusConverter" />
        <cvt:IndexPlusOneConverter x:Key="IndexConverter" />
        <cvt:ThumbnailConverter x:Key="ThumbnailConverter" />
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Name="bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F3F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E4E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#777" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="36" />
        </Style>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E3E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F1F3" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
        </Style>
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#E0E3E8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E3E8"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LocalMark" FontSize="18" FontWeight="Bold"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                    <TextBlock Text="本地数据标注工具" FontSize="13"
                               Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="⚙" Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource SettingsBtn}" ToolTip="系统设置" />
            </Grid>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#F8F9FB" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="20,10" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        BorderBrush="#2563EB"
                                        BorderThickness="0,0,0,0"
                                        Name="tabBorder" Cursor="Hand">
                                    <TextBlock Name="tabLabel"
                                               Text="{TemplateBinding Header}"
                                               Foreground="#666" FontWeight="Normal" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="0,0,0,3" />
                                        <Setter TargetName="tabLabel" Property="Foreground" Value="#2563EB" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#F0F3F8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ============ Tab 1: 素材标注 ============ -->
            <TabItem Header="素材标注">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Background="White"
                            BorderBrush="#E0E3E8" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📄 导入文本" Command="{Binding ImportTextFileCommand}"
                                    Style="{StaticResource ToolBtn}" />
                            <Button Content="🖼 导入图片" Command="{Binding ImportImageFilesCommand}"
                                    Style="{StaticResource ToolBtn}" Margin="6,0,0,0" />
                            <Button Content="📁 导入文件夹" Command="{Binding ImportFolderCommand}"
                                    Style="{StaticResource ToolBtn}" Margin="6,0,0,0" />
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8" />
                            <Button Content="✏️ 手动标注" Command="{Binding OpenMarkViewCommand}"
                                    Style="{StaticResource AccentBtn}" />
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8" />
                                    Style="{StaticResource AiBtn}" />
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8" />
                            <Button Content="📦 导出 JSON" Command="{Binding ExportToJsonCommand}"
                                    Style="{StaticResource ToolBtn}" />
                            <Separator Width="1" Margin="12,4" Background="#E0E3E8" />
                            <Button x:Name="ClearBtn" Content="🗑 清除 ▾"
                                    Style="{StaticResource ToolBtn}" Click="ClearBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="清除已标注（隐藏）"
                                                  Command="{Binding ClearMarkedCommand}" />
                                        <MenuItem Header="清除未标注（删除）"
                                                  Command="{Binding ClearUnmarkedCommand}" />
                                        <Separator />
                                        <MenuItem Header="清除所有"
                                                  Command="{Binding ClearAllCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 筛选栏 -->
                    <Border Grid.Row="1" Padding="16,10,16,6">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="仅显示未标注"
                                      IsChecked="{Binding ShowUnmarkedOnly}"
                                      Foreground="#555" FontSize="13"
                                      VerticalAlignment="Center" />
                            <Separator Width="1" Margin="16,2" Background="#E0E3E8" />
                            <CheckBox Content="全选" IsChecked="{Binding IsAllSelected}"
                                      Foreground="#555" FontSize="13"
                                      VerticalAlignment="Center" />
                            <Separator Width="1" Margin="16,2" Background="#E0E3E8" />
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,4,0" Foreground="#94A3B8" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180" FontSize="13" Padding="6,4"
                                     BorderBrush="#D0D5DD" Background="#FAFBFC"
                                     VerticalAlignment="Center"
                                     ToolTip="搜索文件名或内容" />
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              CanUserAddRows="False"
                              AlternationCount="100000"
                              Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              Margin="14,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F6F8FC" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Background" Value="#FFFDE7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style x:Key="ChkBoxStyle" TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource ChkBoxStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Width="48" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Converter="{StaticResource IndexConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="文件名" Binding="{Binding SourceName}"
                                                Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Width="60"
                                                Binding="{Binding DataType,
                                                Converter={StaticResource DataTypeConverter}}"
                                                IsReadOnly="True" />
                            <DataGridTemplateColumn Header="预览" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Content,
                                               Converter={StaticResource ThumbnailConverter}}"
                                               Width="36" Height="28"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="素材内容" Binding="{Binding Content}"
                                                Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" Width="70" IsReadOnly="True"
                                                Binding="{Binding IsMarked,
                                                Converter={StaticResource MarkedStatusConverter}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- ============ Tab 2: 标注结果 ============ -->
            <TabItem Header="标注结果">
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <TextBlock Text="已完成标注" FontSize="15"
                                   FontWeight="SemiBold" Foreground="#1E293B"
                                   VerticalAlignment="Center" />
                        <Button Content="导出 JSON" Command="{Binding ExportToJsonCommand}"
                                Style="{StaticResource ToolBtn}" Margin="20,0,0,0" />
                        <Button Content="删除全部" Command="{Binding DeleteAllResultsCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0"
                                Foreground="#DC2626" ToolTip="删除所有已完成标注的数据" />
                        <Button Content="刷新" Command="{Binding RefreshSourcesCommand}"
                                Style="{StaticResource ToolBtn}" Margin="8,0,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="ResultGrid"
                              ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F6F8FC" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="48" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Converter="{StaticResource IndexConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="文件名" Width="140"
                                                Binding="{Binding FileName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Width="60"
                                                Binding="{Binding Type}" />
                            <DataGridTextColumn Header="标签" Width="80"
                                                Binding="{Binding Label}" />
                            <DataGridTextColumn Header="标注时间" Width="140"
                                                Binding="{Binding MarkedAt}" />
                            <DataGridTextColumn Header="内容摘要" Width="*"
                                                Binding="{Binding Content}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
