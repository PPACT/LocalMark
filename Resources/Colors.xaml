<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <Color x:Key="BgPrimary">#F8F9FB</Color>
    <Color x:Key="BgSecondary">#FFFFFF</Color>
    <Color x:Key="BgHover">#F0F3F8</Color>
    <Color x:Key="BgSelected">#EFF6FF</Color>
    <Color x:Key="BgHighlight">#FFFDE7</Color>

    <Color x:Key="BorderLight">#E0E3E8</Color>
    <Color x:Key="BorderMedium">#D0D5DD</Color>

    <Color x:Key="TextPrimary">#1E293B</Color>
    <Color x:Key="TextSecondary">#666666</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>

    <Color x:Key="Accent">#2563EB</Color>
    <Color x:Key="AccentHover">#1D4ED8</Color>
    <Color x:Key="AccentLight">#EFF6FF</Color>

    <Color x:Key="AiBg">#FFF7ED</Color>
    <Color x:Key="AiBorder">#FDBA74</Color>
    <Color x:Key="AiText">#C2410C</Color>

    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="Warning">#F59E0B</Color>

    <!-- SolidColorBrush shortcuts -->
    <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource BgPrimary}" />
    <SolidColorBrush x:Key="BrushBgSecondary" Color="{StaticResource BgSecondary}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}" />

</ResourceDictionary>
